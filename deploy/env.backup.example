# Backup settings: copy to /opt/sensoterra/.env.backup and chmod 600.
# The file is passed to the restic container via docker --env-file: values WITHOUT quotes,
# everything after '=' is taken as is.

# restic repository. Examples (pick one):
#   S3-compatible storage (Backblaze B2 S3 API, Yandex Object Storage, Hetzner Object Storage, MinIO):
#     RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/sensoterra-backup
#   Backblaze B2 native API:
#     RESTIC_REPOSITORY=b2:sensoterra-backup:/
#   REST server / rclone serve restic:
#     RESTIC_REPOSITORY=rest:https://user:pass@backup.example.com/sensoterra
RESTIC_REPOSITORY=s3:https://s3.example.com/sensoterra-backup

# Repository encryption password. Without it the backups CANNOT be restored —
# keep it in a password manager, not only here.
# Generate: openssl rand -base64 32
RESTIC_PASSWORD=

# Storage access keys (for s3:). For b2: use B2_ACCOUNT_ID / B2_ACCOUNT_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region, if the storage requires one (e.g. ru-central1 for Yandex).
# AWS_DEFAULT_REGION=

# How many restic snapshots to keep.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12

# How many recent daily dumps to keep locally in backups/daily/.
KEEP_LOCAL_DUMPS=3

# Optional: healthchecks.io (or compatible) check URLs. Pinged after a successful backup /
# restore check; if a ping does not arrive, the service sends an alert.
HEALTHCHECK_URL=
HEALTHCHECK_RESTORE_URL=
