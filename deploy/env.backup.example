# Настройки бэкапа: скопировать в /opt/sensoterra/.env.backup и сделать chmod 600.
# Файл передаётся в контейнер restic через docker --env-file: значения БЕЗ кавычек,
# всё после '=' берётся как есть.

# Репозиторий restic. Примеры (нужен один):
#   S3-совместимое хранилище (Backblaze B2 S3 API, Yandex Object Storage, Hetzner Object Storage, MinIO):
#     RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/sensoterra-backup
#   Backblaze B2 native API:
#     RESTIC_REPOSITORY=b2:sensoterra-backup:/
#   REST server / rclone serve restic:
#     RESTIC_REPOSITORY=rest:https://user:pass@backup.example.com/sensoterra
RESTIC_REPOSITORY=s3:https://s3.example.com/sensoterra-backup

# Пароль шифрования репозитория. Без него бэкапы НЕ восстановить —
# сохраните его в менеджере паролей, а не только здесь.
# Сгенерировать: openssl rand -base64 32
RESTIC_PASSWORD=

# Ключи доступа к хранилищу (для s3:). Для b2: — B2_ACCOUNT_ID / B2_ACCOUNT_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Регион, если хранилище его требует (например, ru-central1 для Yandex).
# AWS_DEFAULT_REGION=

# Сколько снапшотов хранить в restic.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12

# Сколько последних ежедневных дампов держать локально в backups/daily/.
KEEP_LOCAL_DUMPS=3

# Необязательно: URL проверок healthchecks.io (или совместимого сервиса). Пингуется после
# успешного бэкапа / проверки восстановления; если пинга нет — сервис шлёт оповещение.
HEALTHCHECK_URL=
HEALTHCHECK_RESTORE_URL=
