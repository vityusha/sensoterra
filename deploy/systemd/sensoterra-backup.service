# Ежедневный бэкап БД (deploy/backup.sh). Установка — см. docs/INSTALL-prod.md, раздел «Database backups».
# Путь /opt/sensoterra и пользователь deploy — значения по умолчанию оттуда же; если у вас
# другие, поправьте их после копирования в /etc/systemd/system/.
[Unit]
Description=Sensoterra database backup (pg_dump + restic)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/sensoterra
ExecStart=/opt/sensoterra/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
