# Local PostgreSQL/TimescaleDB used by docker-compose.yml
POSTGRES_DB=sensoterra
POSTGRES_USER=sensoterra
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Host port of the web app when running the full stack with docker compose
APP_PORT=3000

# Server database connection (for ./gradlew run on the host; compose sets its own)
DB_URL=jdbc:postgresql://localhost:5432/sensoterra
DB_USER=sensoterra
DB_PASSWORD=change-this-local-password

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-base64-secret

# Supply credentials for your MQTT broker
# Client ID must be unique per running server instance on the broker
SENSOTERRA_MQTT_CLIENT_ID=sensoterra-server-1
SENSOTERRA_MQTT_USERNAME=
SENSOTERRA_MQTT_PASSWORD=

# Optional Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
