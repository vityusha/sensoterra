<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- App log level: SENSOTERRA_LOG_LEVEL from the environment (INFO in prod, see docker-compose.prod.yml).
         Keep it the single place for levels: logger.levels in application*.yml would also apply now
         (micronaut-management brings a LoggingSystem), but two sources of truth get confusing. -->
    <logger name="ru.sensoterra.server" level="${SENSOTERRA_LOG_LEVEL:-DEBUG}"/>
    <logger name="org.eclipse.paho" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
