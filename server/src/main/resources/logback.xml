<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Уровень приложения: SENSOTERRA_LOG_LEVEL из окружения (в проде INFO, см. docker-compose.prod.yml).
         logger.levels в application*.yml не работают — в проекте нет micronaut-management с LoggingSystem. -->
    <logger name="ru.sensoterra.server" level="${SENSOTERRA_LOG_LEVEL:-DEBUG}"/>
    <logger name="org.eclipse.paho" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
